# ---------------------------------------------------------------------------
# Google Drive integration
#
# Create these at https://console.cloud.google.com/apis/credentials:
#   1. Create (or pick) a project
#   2. Enable the "Google Drive API"
#   3. Configure the OAuth consent screen
#        - "Internal" if this is a Google Workspace org (no verification needed)
#        - "External" otherwise; add your own account under Test users
#      Add exactly one scope: .../auth/drive.readonly
#   4. Credentials -> Create credentials -> OAuth client ID -> Web application
#   5. Under "Authorised redirect URIs" add the value of GOOGLE_REDIRECT_URI
#      below, character for character. Google matches it exactly.
#
# Copy this file to .env and fill in the two secrets. .env is read at API
# startup. Never commit it.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Development (API on :8787). Must match the console entry exactly.
GOOGLE_REDIRECT_URI=http://localhost:8787/api/integrations/oauth/google/callback
# Production example — register this one too, and swap it in on deploy:
# GOOGLE_REDIRECT_URI=https://api.your-domain.com/api/integrations/oauth/google/callback

# Where the OAuth popup posts its result. The app's own origin, never "*".
APP_BASE_URL=http://localhost:5180
# Production: APP_BASE_URL=https://app.your-domain.com

# Browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

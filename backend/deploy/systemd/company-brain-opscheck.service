[Unit]
Description=Company Brain health probe (site + API + database)
OnFailure=company-brain-heal.service

[Service]
Type=oneshot
User=brain
Group=brain
WorkingDirectory=/srv/company-brain/scraper
EnvironmentFile=/etc/company-brain/env
Environment=PYTHONPATH=/srv/company-brain/scraper
ExecStart=/srv/company-brain/.venv/bin/python -m regulatory_ingestion.opscheck probe
